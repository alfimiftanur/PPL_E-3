  "initialAnalysisSamples": [
    {
      "analysisId": "1",
      "projectNeed": "Migrasi core transaction ke arsitektur microservices berdaya tampung 5.000 TPS, enkripsi mTLS penuh antar layanan internal, integrasi settlement otomatis SNAP BI-FAST secara real-time, serta penyediaan dasbor rekonsiliasi terpusat bagi divisi operasional dan kepatuhan perbankan PT Nusantara Sejahtera Pratama, Tbk.",
      "projectCondition": "Server klien on-premise telah terpasang CentOS 9 Stream dengan klaster database PostgreSQL HA, tim lead architect internal telah disiagakan, dokumen kontrak payung telah ditandatangani, namun otorisasi firewall koneksi database masih dalam proses persetujuan IT Security."
    },
    {
      "analysisId": "2",
      "projectNeed": "Pembangunan gateway otentikasi biometrik wajah dan sidik jari untuk nasabah mobile banking dengan latensi verifikasi di bawah 250ms serta kepatuhan penuh terhadap standar ISO/IEC 27001 dan PDP.",
      "projectCondition": "Infrastruktur cloud hybrid sudah tersedia di dua data center Jakarta dan Surabaya, SDK e-KTP reader telah siap diuji coba, menunggu finalisasi sertifikat SSL wildcard dari tim infrastruktur klien."
    },
    {
      "analysisId": "3",
      "projectNeed": "Otomatisasi pelacakan kontainer berbasis IoT dan sinkronisasi manifest barang secara real-time antara sistem gudang pelabuhan dengan modul akuntansi pusat ERP.",
      "projectCondition": "Perangkat sensor RFID di 4 terminal utama sudah terpasang, API sandbox bea cukai telah dapat diakses, namun skema migrasi master SKU lama masih perlu pembersihan duplikasi data."
    },
    {
      "analysisId": "4",
      "projectNeed": "Sentralisasi pemrosesan klaim polis kesehatan dan perhitungan cadangan teknis aktuaria otomatis berbasis aturan underwriting dinamis dengan target pemrosesan 10.000 klaim harian.",
      "projectCondition": "Database historis polis 5 tahun terakhir tersimpan di Oracle Data Warehouse, tim aktuaria klien telah menyerahkan rumus perhitungan standar, lingkungan staging sudah siap digunakan."
    },
    {
      "analysisId": "5",
      "projectNeed": "Penyusunan engine pelaporan likuiditas harian otomatis (LCR/NSFR) dan integrasi settlement obligasi korporasi ke sistem pelaporan regulator OJK dan Bank Indonesia.",
      "projectCondition": "Dokumen spesifikasi format pelaporan e-Reporting terbaru sudah lengkap, server aplikasi staging berbasis Kubernetes telah berjalan normal, tim QA dan kepatuhan klien siap mendampingi."
    }
  ],
